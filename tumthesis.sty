% ---------------------------------------------------------------------------
% Typography and numbering
% ---------------------------------------------------------------------------

\newcommand{\thesisfontsize}{11}
\newcommand{\thesisbaselineskip}{13}
\AtBeginDocument{\fontsize{\thesisfontsize}{\thesisbaselineskip}\selectfont}
\renewcommand{\bfdefault}{b}
\numberwithin{equation}{chapter}

% ---------------------------------------------------------------------------
% Thesis metadata and front-matter content
% ---------------------------------------------------------------------------

\newcommand{\institutionlogo}{tum_bw_logo.pdf}
\newcommand{\bottomlogo}{tum_ma_logo.pdf}
\newcommand{\authorsignature}{signature_hw_bw.png}

% Research Group
\newcommand{\researchgroup}{Research Group}

% Department
\newcommand{\departmentprefix}{Department of}
\newcommand{\department}{X}

% School
\newcommand{\school}{}
\newcommand{\schoolprefix}{School of}

\newcommand{\university}{Technical University of Munich}
\newcommand{\tumthesiscurrentlanguage}{en}

\newcommand{\thesislanguage}[1]{%
  \renewcommand{\tumthesiscurrentlanguage}{#1}%
  \ifdefstring{\tumthesiscurrentlanguage}{en}{%
    \renewcommand{\university}{Technical University of Munich}%
  }{%
    \ifdefstring{\tumthesiscurrentlanguage}{de}{%
      \renewcommand{\university}{Technische Universität München}%
    }{%
      \PackageError{tumthesis}{Unknown thesis language `#1'}{%
        Use `en' or `de'.%
      }%
    }%
  }%
}
\newcommand{\institutiontext}{%
  \textsf{\researchgroup}\\
  \textsf{\departmentprefix\ \department}\\
  \ifdefempty{\school}{\textsf{\university}}{\textsf{\schoolprefix\ \school}}%
}

\newcommand{\thesisauthor}{John Doe}
\newcommand{\supervisor}{Supervisor Doe}
\newcommand{\advisor}{Advisor Doe}
\newcommand{\submissiondate}{01.01.1970}
\newcommand{\subtitle}{}
\newcommand{\thesisdegree}{Bachelor of Science (B.\,Sc.)}
\newcommand{\thesisprogram}{Mathematics}

\newcommand{\abstracten}{\lipsum[1]}
\newcommand{\abstractde}{\lipsum[2]}

% ---------------------------------------------------------------------------
% Math helpers
% ---------------------------------------------------------------------------

\DeclareMathOperator{\diam}{diam}
\DeclareMathOperator{\Var}{Var}
\DeclareMathOperator{\Cov}{Cov}
\DeclareMathOperator{\argmax}{arg\,max}
\DeclareMathOperator{\spanLA}{span}

\newcommand{\greekrm}[1]{%
  \ifmmode
    \text{\normalfont\textrm{#1}}%
  \else
    {\normalfont\textrm{#1}}%
  \fi
}

\ExplSyntaxOn
\clist_new:N \g_tumthesis_textgreek_regular_clist
\clist_gset:Nn \g_tumthesis_textgreek_regular_clist
  {
    alpha, beta, gamma, delta, epsilon, zeta, eta, theta, iota, kappa,
    lambda, nu, xi, pi, sigma, tau, upsilon, phi, chi, psi, omega,
    Gamma, Delta, Theta, Lambda, Xi, Pi, Sigma, Upsilon, Phi, Psi, Omega
  }

\prop_new:N \g_tumthesis_textgreek_irregular_prop
\prop_gset_from_keyval:Nn \g_tumthesis_textgreek_irregular_prop
  {
    mu         = textmugreek,
    rho        = textrho,
    varepsilon = straightepsilon,
    vartheta   = scripttheta,
    varsigma   = textvarsigma,
    varphi     = straightphi
  }

\cs_new_protected:Npn \tumthesis_textgreek_renew:nn #1#2
  {
    \cs_set_protected:cpn {#1} { \greekrm { \use:c {#2} } }
  }

\cs_new_protected:Npn \tumthesis_textgreek_renew_regular:n #1
  {
    \tumthesis_textgreek_renew:nn {#1} { text#1 }
  }

\cs_new_protected:Npn \tumthesis_textgreek_apply:
  {
    \clist_map_inline:Nn \g_tumthesis_textgreek_regular_clist
      { \tumthesis_textgreek_renew_regular:n {##1} }
    \prop_map_inline:Nn \g_tumthesis_textgreek_irregular_prop
      { \tumthesis_textgreek_renew:nn {##1} {##2} }
  }

\cs_new_eq:NN \usetextgreek \tumthesis_textgreek_apply:
\ExplSyntaxOff

\AtBeginDocument{\ifusetextgreek\usetextgreek\fi}

% ---------------------------------------------------------------------------
% Title and front matter
% ---------------------------------------------------------------------------

\newlength{\logoh}
\setlength{\logoh}{3\baselineskip}

\makeatletter
\newcommand{\tumthesis@titlepage}{%
  \begin{titlepage}
    \noindent
    \begin{minipage}[c]{0.65\textwidth}
      \raggedright
      \institutiontext
    \end{minipage}%
    \begin{minipage}[c]{0.35\textwidth}
      \raggedleft
      \includegraphics[height=\logoh]{\institutionlogo}
    \end{minipage}

    \vspace{2cm}

    \begin{center}
      {\Huge\bfseries \thetitle \par}
      {\large\bfseries \subtitle \par}
    \end{center}

    \vspace{3.0cm}

    \raggedright
    {\huge\textbf{\thesisauthor}\par}
    \vspace{3.0cm}
    {\large Thesis for the attainment of the academic degree\\%
      \textbf{\thesisdegree} in \thesisprogram\par}
    \vspace{3.0cm}
    {\large
      \textbf{Supervisor:}\\ \supervisor \par
      \textbf{Advisor:}\\ \advisor \par
      \textbf{Submitted:}\\ \submissiondate \par
    }

    \vfill
    \begin{center}
      \includegraphics[height=2cm,keepaspectratio]{\bottomlogo}
    \end{center}
  \end{titlepage}
}

\newcommand{\tumthesis@declaration}{%
  \clearpage
  \thispagestyle{empty}
  \vspace*{\fill}
  \noindent
  I hereby declare that this thesis is entirely the result of my own work except
  where otherwise indicated. I have only used the resources given in the list of
  references.

  \vspace{0.5cm}

  \noindent
  \submissiondate\hfill
  \raisebox{-0.18\height}{\includegraphics[height=2.5cm]{\authorsignature}}
  \clearpage
}

\newcommand{\makeabstract}{%
  \section*{Abstract}
  \abstracten

  \section*{Zusammenfassung}
  \abstractde
}

\newcommand{\tumthesis@abstracts}{%
  \thispagestyle{plain}
  \makeabstract
  \clearpage
}

\newcommand{\tumthesis@contents}{%
  \tableofcontents
  \clearpage
}

\renewcommand{\maketitle}{%
  \tumthesis@titlepage
  \tumthesis@declaration
  \tumthesis@abstracts
  \tumthesis@contents
}
\makeatother

% ---------------------------------------------------------------------------
% Chapter headings and page style
% ---------------------------------------------------------------------------

\titleformat{\chapter}[display]
  {\centering\Huge\bfseries}
  {Chapter \thechapter}
  {1ex}
  {\Huge}

\titlespacing*{\chapter}
  {0pt}
  {0pt}
  {2\baselineskip}

\titleformat{name=\chapter,numberless}[block]
  {\huge\bfseries\raggedright}
  {}
  {0pt}
  {}

\renewcommand{\cfttoctitlefont}{\Huge\bfseries\raggedright}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.01pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[LE]{\nouppercase{\rightmark}}
\fancyhead[RO]{\nouppercase{\leftmark}}
\fancyfoot[C]{\thepage}

\fancypagestyle{plain}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \fancyfoot[C]{\thepage}%
}

% ---------------------------------------------------------------------------
% Theorem environments
% ---------------------------------------------------------------------------

\newtheoremstyle{tumplain}
  {3pt}
  {3pt}
  {\itshape}
  {1em}
  {\bfseries}
  {}
  {0.8em}
  {}
\theoremstyle{tumplain}
\newtheorem{theorem}{Theorem}[chapter]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}

\newtheoremstyle{tumdef}
  {3pt}
  {3pt}
  {\normalfont}
  {1em}
  {\bfseries}
  {}
  {0.8em}
  {}
\theoremstyle{tumdef}
\newtheorem{definition}[theorem]{Definition}

\newtheoremstyle{tumnote}
  {3pt}
  {3pt}
  {\normalfont}
  {1em}
  {\bfseries}
  {.}
  {0.8em}
  {}
\theoremstyle{tumnote}
\newtheorem*{note}{Note}

% ---------------------------------------------------------------------------
% Bibliography and URL handling
% ---------------------------------------------------------------------------

\renewcommand{\bibname}{Bibliography}
\defbibheading{bibintoc}[\bibname]{%
  \chapter*{#1\markboth{#1}{#1}}%
}

\Urlmuskip=0mu plus 2mu\relax
\appto{\biburlsetup}{\Urlmuskip=0mu plus 2mu\relax}
\setcounter{biburlnumpenalty}{100}
\setcounter{biburlucpenalty}{100}
\setcounter{biburllcpenalty}{100}
\appto{\bibsetup}{\emergencystretch=1em}

\endinput
